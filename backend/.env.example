RAPIDAPI_KEY=

# Application settings
JWT_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:4200

# Enable the mail poller only when explicitly configured
MAIL_POLL_ENABLED=false

# IMAP / SMTP credentials (only required if enabling the mail poller)
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
MAIL_POLL_INTERVAL=60

# SMTP settings for outgoing email (password reset, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
